    "Limit the total number of input tokens for the model (including historical messages and current input). Max: %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحديد العدد الإجمالي لرموز الإدخال للنموذج (بما في ذلك الرسائل التاريخية والإدخال الحالي). الحد الأقصى: %lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiteu el nombre total de fitxes d'entrada per al model (inclosos els missatges històrics i l'entrada actual). Màxim: %lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezte celkový počet vstupních tokenů pro model (včetně historických zpráv a aktuálního vstupu). Max: %lld."
