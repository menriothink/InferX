          "stringUnit": {
            "state": "translated",
            "value": "Выберите из наиболее вероятных токенов, суммарная частота дискретизации которых равна P."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte z najpravdepodobnejších tokenov, ktorých súčet vzorkovacej frekvencie je P."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj bland de mest sannolika tokens vars summasamplingsfrekvens är P."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกจากโทเค็นที่น่าจะเป็นไปได้มากที่สุดซึ่งมีอัตราการสุ่มตัวอย่างรวมคือ P"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplam örnekleme oranı P olan en olası tokenlar arasından seçim yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть із найбільш імовірних токенів, частота вибірки яких P."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn từ các mã thông báo có khả năng xảy ra cao nhất có tổng tỷ lệ lấy mẫu là P."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "從總採樣率為 P 的最可能的標記中進行選擇。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从累积概率为 P 的最可能令牌中选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從總採樣率為 P 的最可能的標記中進行選擇。"
          }
        }
      }
    },
