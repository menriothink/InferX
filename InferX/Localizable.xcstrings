    "Connecting to a local or cloud model requires adding an API configuration first.\nLet's start here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب الاتصال بنموذج محلي أو سحابي إضافة تكوين واجهة برمجة التطبيقات (API) أولاً.\nلنبدأ هنا."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Per connectar-vos a un model local o al núvol cal afegir primer una configuració d'API.\nComencem per aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojení k místnímu nebo cloudovému modelu vyžaduje nejprve přidání konfigurace API.\nZačněme zde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forbindelse til en lokal eller cloud-model kræver først tilføjelse af en API-konfiguration.\nLad os starte her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine Verbindung zu einem lokalen oder Cloud-Modell herzustellen, muss zunächst eine API-Konfiguration hinzugefügt werden.\nBeginnen wir hier."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση σε τοπικό μοντέλο ή μοντέλο cloud απαιτεί πρώτα την προσθήκη μιας διαμόρφωσης API.\nΑς ξεκινήσουμε εδώ."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to a local or cloud model requires adding an API configuration first.\nLet's start here."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to a local or cloud model requires adding an API configuration first.\nLet's start here."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to a local or cloud model requires adding an API configuration first.\nLet's start here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para conectarse a un modelo local o en la nube es necesario agregar primero una configuración de API.\nEmpecemos aquí."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Para conectarse a un modelo local o en la nube es necesario agregar primero una configuración de API.\nEmpecemos aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yhteyden muodostaminen paikalliseen tai pilvimalliin vaatii ensin API-määrityksen lisäämisen.\nAloitetaan tästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à un modèle local ou cloud nécessite d'abord l'ajout d'une configuration API.\nCommençons ici."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à un modèle local ou cloud nécessite d'abord l'ajout d'une configuration API.\nCommençons ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברות למודל מקומי או ענן דורשת תחילה הוספת תצורת API.\nבואו נתחיל כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय या क्लाउड मॉडल से कनेक्ट करने के लिए पहले एक एपीआई कॉन्फ़िगरेशन जोड़ने की आवश्यकता होती है।\nआइए यहां से शुरू करें."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povezivanje s lokalnim modelom ili modelom u oblaku prvo zahtijeva dodavanje konfiguracije API-ja.\nPočnimo ovdje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Helyi vagy felhőmodellhez való csatlakozáshoz először API-konfigurációt kell hozzáadni.\nKezdjük itt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghubungkan ke model lokal atau cloud memerlukan penambahan konfigurasi API terlebih dahulu.\nMari kita mulai dari sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione a un modello locale o cloud richiede prima l'aggiunta di una configurazione API.\nCominciamo da qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルまたはクラウド モデルに接続するには、最初に API 構成を追加する必要があります。\nここから始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 또는 클라우드 모델에 연결하려면 먼저 API 구성을 추가해야 합니다.\n여기서 시작해 보겠습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyambung kepada model setempat atau awan memerlukan penambahan konfigurasi API terlebih dahulu.\nMari mulakan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til en lokal eller skymodell krever først å legge til en API-konfigurasjon.\nLa oss begynne her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om verbinding te maken met een lokaal of cloudmodel moet eerst een API-configuratie worden toegevoegd.\nLaten we hier beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie z modelem lokalnym lub chmurowym wymaga najpierw dodania konfiguracji API.\nZacznijmy tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão a um modelo local ou de nuvem requer primeiro a adição de uma configuração de API.\nVamos começar aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão a um modelo local ou de nuvem requer primeiro a adição de uma configuração de API.\nVamos começar aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea la un model local sau cloud necesită mai întâi adăugarea unei configurații API.\nSă începem aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для подключения к локальной или облачной модели необходимо сначала добавить конфигурацию API.\nДавайте начнем здесь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pripojenie k lokálnemu alebo cloudovému modelu vyžaduje najprv pridanie konfigurácie API.\nZačnime tu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att ansluta till en lokal modell eller molnmodell måste du lägga till en API-konfiguration först.\nLåt oss börja här."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเชื่อมต่อกับโมเดลภายในเครื่องหรือบนคลาวด์จำเป็นต้องเพิ่มการกำหนดค่า API ก่อน\nเรามาเริ่มกันที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel veya bulut modeline bağlanmak için öncelikle bir API yapılandırmasının eklenmesi gerekir.\nBuradan başlayalım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для підключення до локальної або хмарної моделі спочатку потрібно додати конфігурацію API.\nПочнемо тут."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc kết nối với mô hình cục bộ hoặc đám mây yêu cầu phải thêm cấu hình API trước.\nHãy bắt đầu ở đây."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連接到本地或云模型需要先添加 API 配置。\n讓我們從這裡開始吧。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接本地或云端模型需要先添加 API 配置。\n从这里开始吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接到本地或云模型需要先添加 API 配置。\n讓我們從這裡開始吧。"
          }
        }
      }
    },
