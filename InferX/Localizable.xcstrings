        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nykyisestä hakemistosta ei löytynyt saatavilla olevia malleja. Lisää ja lataa malliyhteisösivulta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle disponible trouvé dans le répertoire actuel. Veuillez ajouter et télécharger à partir de la page de la communauté des modèles."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle disponible trouvé dans le répertoire actuel. Veuillez ajouter et télécharger à partir de la page de la communauté des modèles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצאו דגמים זמינים בספרייה הנוכחית. אנא הוסף והורד מדף קהילת המודל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान निर्देशिका में कोई उपलब्ध मॉडल नहीं मिला। कृपया मॉडल समुदाय पृष्ठ से जोड़ें और डाउनलोड करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema dostupnih modela u trenutnom direktoriju. Dodajte i preuzmite sa stranice zajednice modela."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az aktuális könyvtárban nem található elérhető modell. Kérjük, adja hozzá és töltse le a modell közösségi oldaláról."
