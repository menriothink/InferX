    "Click the button below to create your first chat session.\nStart exploring the endless possibilities of AI.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر فوق الزر أدناه لإنشاء جلسة الدردشة الأولى.\nابدأ باستكشاف الإمكانيات اللانهائية للذكاء الاصطناعي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Feu clic al botó següent per crear la vostra primera sessió de xat.\nComenceu a explorar les infinites possibilitats de la IA."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím na tlačítko níže vytvoříte svou první chatovací relaci.\nZačněte objevovat nekonečné možnosti umělé inteligence."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på knappen nedenfor for at oprette din første chatsession.\nBegynd at udforske de uendelige muligheder ved AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf die Schaltfläche unten, um Ihre erste Chat-Sitzung zu erstellen.\nErkunden Sie die endlosen Möglichkeiten der KI."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε κλικ στο κουμπί παρακάτω για να δημιουργήσετε την πρώτη σας περίοδο συνομιλίας.\nΞεκινήστε να εξερευνάτε τις ατελείωτες δυνατότητες του AI."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the button below to create your first chat session.\nStart exploring the endless possibilities of AI."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the button below to create your first chat session.\nStart exploring the endless possibilities of AI."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the button below to create your first chat session.\nStart exploring the endless possibilities of AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic en el botón a continuación para crear su primera sesión de chat.\nEmpiece a explorar las infinitas posibilidades de la IA."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic en el botón a continuación para crear su primera sesión de chat.\nEmpiece a explorar las infinitas posibilidades de la IA."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napsauta alla olevaa painiketta luodaksesi ensimmäisen chat-istunnon.\nAloita tekoälyn loputtomien mahdollisuuksien tutkiminen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bouton ci-dessous pour créer votre première session de chat.\nCommencez à explorer les possibilités infinies de l’IA."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le bouton ci-dessous pour créer votre première session de chat.\nCommencez à explorer les possibilités infinies de l’IA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ על הלחצן למטה כדי ליצור את הפעלת הצ'אט הראשונה שלך.\nהתחל לחקור את האפשרויות האינסופיות של AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना पहला चैट सत्र बनाने के लिए नीचे दिए गए बटन पर क्लिक करें।\nएआई की अनंत संभावनाओं की खोज शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pritisnite donji gumb da biste kreirali svoju prvu sesiju razgovora.\nPočnite istraživati ​​beskrajne mogućnosti umjetne inteligencije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kattintson az alábbi gombra az első csevegés létrehozásához.\nKezdje el felfedezni az AI végtelen lehetőségeit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik tombol di bawah untuk membuat sesi obrolan pertama Anda.\nMulailah menjelajahi kemungkinan AI yang tak terbatas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic sul pulsante in basso per creare la tua prima sessione di chat.\nInizia a esplorare le infinite possibilità dell'intelligenza artificiale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のボタンをクリックして、最初のチャット セッションを作成します。\nAI の無限の可能性を探求しましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 채팅 세션을 만들려면 아래 버튼을 클릭하세요.\nAI의 무한한 가능성을 탐구해 보세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik butang di bawah untuk membuat sesi sembang pertama anda.\nMula meneroka kemungkinan AI yang tidak berkesudahan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på knappen nedenfor for å opprette din første chat-økt.\nBegynn å utforske de uendelige mulighetene til AI."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op de onderstaande knop om uw eerste chatsessie te maken.\nOntdek de eindeloze mogelijkheden van AI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij poniższy przycisk, aby utworzyć pierwszą sesję czatu.\nZacznij odkrywać nieskończone możliwości sztucznej inteligencji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão abaixo para criar sua primeira sessão de chat.\nComece a explorar as infinitas possibilidades da IA."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique no botão abaixo para criar sua primeira sessão de chat.\nComece a explorar as infinitas possibilidades da IA."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Faceți clic pe butonul de mai jos pentru a crea prima dvs. sesiune de chat.\nÎncepeți să explorați posibilitățile nesfârșite ale AI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку ниже, чтобы создать свой первый сеанс чата.\nНачните исследовать безграничные возможности ИИ."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknutím na tlačidlo nižšie vytvoríte svoju prvú chatovaciu reláciu.\nZačnite skúmať nekonečné možnosti AI."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka på knappen nedan för att skapa din första chattsession.\nBörja utforska de oändliga möjligheterna med AI."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิกปุ่มด้านล่างเพื่อสร้างเซสชั่นการแชทแรกของคุณ\nเริ่มสำรวจความเป็นไปได้อันไม่มีที่สิ้นสุดของ AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk sohbet oturumunuzu oluşturmak için aşağıdaki düğmeye tıklayın.\nYapay zekanın sonsuz olanaklarını keşfetmeye başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку нижче, щоб створити свій перший сеанс чату.\nПочніть досліджувати нескінченні можливості ШІ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp vào nút bên dưới để tạo phiên trò chuyện đầu tiên của bạn.\nBắt đầu khám phá khả năng vô tận của AI."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "單擊下面的按鈕創建您的第一個聊天會話。\n開始探索人工智能的無限可能性。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击下方按钮创建你的第一个聊天会话。\n开始探索 AI 的无限可能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單擊下面的按鈕創建您的第一個聊天會話。\n開始探索人工智能的無限可能性。"
          }
        }
      }
