    "Optional integer to set the seed for random generations, for consistency. Useful for testing or reproducing results.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد صحيح اختياري لتعيين البذور للأجيال العشوائية، من أجل الاتساق. مفيدة للاختبار أو إعادة إنتاج النتائج."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter opcional per establir la llavor per a generacions aleatòries, per a la coherència. Útil per provar o reproduir resultats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Volitelné celé číslo pro nastavení semene pro náhodné generování pro konzistenci. Užitečné pro testování nebo reprodukci výsledků."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfrit heltal til at indstille frøet til tilfældige generationer, for konsistens. Nyttigt til test eller gengivelse af resultater."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionale Ganzzahl, um aus Konsistenzgründen den Startwert für zufällige Generationen festzulegen. Nützlich zum Testen oder Reproduzieren von Ergebnissen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προαιρετικός ακέραιος αριθμός για τον καθορισμό του σπόρου για τυχαίες γενιές, για συνέπεια. Χρήσιμο για δοκιμή ή αναπαραγωγή αποτελεσμάτων."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional integer to set the seed for random generations, for consistency. Useful for testing or reproducing results."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional integer to set the seed for random generations, for consistency. Useful for testing or reproducing results."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional integer to set the seed for random generations, for consistency. Useful for testing or reproducing results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entero opcional para establecer la semilla para generaciones aleatorias, por coherencia. Útil para probar o reproducir resultados."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Entero opcional para establecer la semilla para generaciones aleatorias, por coherencia. Útil para probar o reproducir resultados."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valinnainen kokonaisluku, jolla asetetaan siemen satunnaisille sukupolville johdonmukaisuuden vuoksi. Hyödyllinen tulosten testaamiseen tai toistamiseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entier facultatif pour définir la graine des générations aléatoires, par souci de cohérence. Utile pour tester ou reproduire des résultats."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Entier facultatif pour définir la graine des générations aléatoires, par souci de cohérence. Utile pour tester ou reproduire des résultats."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספר שלם אופציונלי להגדרת הזרע לדורות אקראיים, לצורך עקביות. שימושי לבדיקה או לשחזור תוצאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निरंतरता के लिए, यादृच्छिक पीढ़ियों के लिए बीज सेट करने के लिए वैकल्पिक पूर्णांक। परीक्षण या परिणाम पुनरुत्पादन के लिए उपयोगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobavezni cijeli broj za postavljanje početne vrijednosti za nasumične generacije, radi dosljednosti. Korisno za testiranje ili reprodukciju rezultata."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionális egész szám a mag beállításához véletlenszerű generációkhoz a következetesség érdekében. Hasznos teszteléshez vagy eredmények reprodukálásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilangan bulat opsional untuk menetapkan benih untuk generasi acak, untuk konsistensi. Berguna untuk menguji atau mereproduksi hasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intero facoltativo per impostare il seme per generazioni casuali, per coerenza. Utile per testare o riprodurre i risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一貫性を保つために、ランダム生成のシードを設定するためのオプションの整数。結果のテストまたは再現に役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일관성을 위해 무작위 생성을 위한 시드를 설정하는 선택적 정수입니다. 결과를 테스트하거나 재현하는 데 유용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Integer pilihan untuk menetapkan benih untuk generasi rawak, untuk konsistensi. Berguna untuk menguji atau menghasilkan semula keputusan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Valgfritt heltall for å sette frøet for tilfeldige generasjoner, for konsistens. Nyttig for å teste eller reprodusere resultater."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel geheel getal om het zaad voor willekeurige generaties in te stellen, voor consistentie. Handig voor het testen of reproduceren van resultaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalna liczba całkowita służąca do ustawiania materiału siewnego losowych generacji w celu zapewnienia spójności. Przydatne do testowania lub odtwarzania wyników."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inteiro opcional para definir a semente para gerações aleatórias, para consistência. Útil para testar ou reproduzir resultados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inteiro opcional para definir a semente para gerações aleatórias, para consistência. Útil para testar ou reproduzir resultados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Opțional întreg pentru a seta sămânța pentru generații aleatorii, pentru consistență. Util pentru testarea sau reproducerea rezultatelor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательное целое число для установки начального значения для случайных поколений в целях согласованности. Полезно для тестирования или воспроизведения результатов."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Voliteľné celé číslo na nastavenie zdroja pre náhodné generácie, aby sa dosiahla konzistentnosť. Užitočné na testovanie alebo reprodukovanie výsledkov."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfritt heltal för att ställa in kärnan för slumpmässiga generationer, för konsekvens. Användbar för att testa eller reproducera resultat."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเต็มทางเลือกเพื่อตั้งค่าเริ่มต้นสำหรับรุ่นสุ่มเพื่อความสม่ำเสมอ มีประโยชน์สำหรับการทดสอบหรือทำซ้ำผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutarlılık sağlamak amacıyla rastgele nesiller için tohumu ayarlamak için isteğe bağlı tamsayı. Sonuçları test etmek veya yeniden oluşturmak için kullanışlıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язкове ціле число для встановлення початкового числа для випадкових генерацій для узгодженості. Корисно для тестування або відтворення результатів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số nguyên tùy chọn để đặt hạt giống cho các thế hệ ngẫu nhiên, nhằm đảm bảo tính nhất quán. Hữu ích cho việc thử nghiệm hoặc tái tạo kết quả."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可選整數，用於設置隨機生成的種子，以保持一致性。對於測試或重現結果很有用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选整数，用于设置随机生成的种子以确保一致性。适用于测试或复现结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選整數，用於設置隨機生成的種子，以保持一致性。對於測試或重現結果很有用。"
          }
        }
      }
