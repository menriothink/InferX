    "No available models found in the current directory. Please add and download from the model community page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على نماذج متاحة في الدليل الحالي. يرجى الإضافة والتنزيل من صفحة المجتمع النموذجي."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'han trobat models disponibles al directori actual. Si us plau, afegiu i descarregueu des de la pàgina de la comunitat de models."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V aktuálním adresáři nebyly nalezeny žádné dostupné modely. Přidejte a stáhněte si je ze stránky komunity modelu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen tilgængelige modeller fundet i den aktuelle mappe. Tilføj og download fra modelfællesskabssiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im aktuellen Verzeichnis wurden keine verfügbaren Modelle gefunden. Bitte hinzufügen und von der Modell-Community-Seite herunterladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκαν διαθέσιμα μοντέλα στον τρέχοντα κατάλογο. Προσθέστε και πραγματοποιήστε λήψη από τη σελίδα κοινότητας μοντέλων."
          }
        },
        "en-AU": {
          "stringUnit": {
