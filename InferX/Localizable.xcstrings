    "Number of historical messages to carry when sending new messages to the model. Recommended range 0-50.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد الرسائل التاريخية المطلوب حملها عند إرسال رسائل جديدة إلى النموذج. النطاق الموصى به 0-50."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de missatges històrics que cal portar quan s'envien missatges nous al model. Interval recomanat 0-50."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet historických zpráv, které se mají přenést při odesílání nových zpráv do modelu. Doporučený rozsah 0-50."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Antal historiske beskeder, der skal medbringes, når der sendes nye beskeder til modellen. Anbefalet område 0-50."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzahl der historischen Nachrichten, die beim Senden neuer Nachrichten an das Modell übertragen werden sollen. Empfohlener Bereich 0-50."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αριθμός ιστορικών μηνυμάτων που πρέπει να μεταφέρονται κατά την αποστολή νέων μηνυμάτων στο μοντέλο. Προτεινόμενο εύρος 0-50."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of historical messages to carry when sending new messages to the model. Recommended range 0-50."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of historical messages to carry when sending new messages to the model. Recommended range 0-50."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Number of historical messages to carry when sending new messages to the model. Recommended range 0-50."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de mensajes históricos a llevar al enviar nuevos mensajes al modelo. Rango recomendado 0-50."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de mensajes históricos a llevar al enviar nuevos mensajes al modelo. Rango recomendado 0-50."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukana olevien historiallisten viestien määrä, kun malliin lähetetään uusia viestejä. Suositeltu alue 0-50."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de messages historiques à transporter lors de l'envoi de nouveaux messages au modèle. Plage recommandée 0-50."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de messages historiques à transporter lors de l'envoi de nouveaux messages au modèle. Plage recommandée 0-50."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספר ההודעות ההיסטוריות שיש לשאת בעת שליחת הודעות חדשות לדגם. טווח מומלץ 0-50."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल पर नए संदेश भेजते समय ले जाने वाले ऐतिहासिक संदेशों की संख्या। अनुशंसित सीमा 0-50।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Broj povijesnih poruka za prijenos prilikom slanja novih poruka modelu. Preporučeni raspon 0-50."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A modellnek új üzenetek küldésekor hordozandó előzményüzenetek száma. Javasolt tartomány 0-50."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumlah pesan historis yang harus dibawa saat mengirim pesan baru ke model. Kisaran yang disarankan 0-50."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Numero di messaggi storici da trasportare quando si inviano nuovi messaggi al modello. Intervallo consigliato 0-50."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいメッセージをモデルに送信するときに伝送する履歴メッセージの数。推奨範囲は 0 ～ 50。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델에 새 메시지를 보낼 때 전달할 기록 메시지 수입니다. 권장 범위는 0-50입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilangan mesej sejarah untuk dibawa semasa menghantar mesej baharu kepada model. Julat yang disyorkan 0-50."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Antall historiske meldinger å bære når du sender nye meldinger til modellen. Anbefalt område 0-50."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aantal historische berichten dat moet worden verzonden bij het verzenden van nieuwe berichten naar het model. Aanbevolen bereik 0-50."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba komunikatów historycznych do przeniesienia podczas wysyłania nowych komunikatów do modelu. Zalecany zakres 0-50."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de mensagens históricas a serem transportadas ao enviar novas mensagens ao modelo. Faixa recomendada 0-50."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Número de mensagens históricas a serem transportadas ao enviar novas mensagens ao modelo. Faixa recomendada 0-50."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numărul de mesaje istorice de transportat atunci când trimiteți mesaje noi către model. Interval recomandat 0-50."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Количество исторических сообщений, которые необходимо перенести при отправке новых сообщений в модель. Рекомендуемый диапазон 0–50."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet historických správ, ktoré sa majú preniesť pri odosielaní nových správ do modelu. Odporúčaný rozsah 0-50."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Antal historiska meddelanden att bära när nya meddelanden skickas till modellen. Rekommenderat intervall 0-50."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนข้อความประวัติที่ต้องดำเนินการเมื่อส่งข้อความใหม่ไปยังโมเดล ช่วงที่แนะนำ 0-50"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modele yeni mesajlar gönderilirken taşınacak geçmiş mesajların sayısı. Önerilen aralık 0-50."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість історичних повідомлень для перенесення під час надсилання нових повідомлень до моделі. Рекомендований діапазон 0-50."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lượng tin nhắn lịch sử cần mang theo khi gửi tin nhắn mới đến mô hình. Phạm vi khuyến nghị 0-50."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "向模型發送新消息時要攜帶的歷史消息數。建議範圍 0-50。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
