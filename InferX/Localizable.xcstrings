    "Select from the most probable tokens whose sum sampling rate is P.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من بين الرموز المميزة الأكثر احتمالاً والتي يكون معدل أخذ العينات الإجمالي فيها هو P."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccioneu entre les fitxes més probables la taxa de mostreig suma de les quals sigui P."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte z nejpravděpodobnějších tokenů, jejichž součet vzorkovací frekvence je P."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg blandt de mest sandsynlige tokens, hvis sumsamplinghastighed er P."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie aus den wahrscheinlichsten Token aus, deren Summenabtastrate P ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε από τα πιο πιθανά διακριτικά των οποίων ο ρυθμός αθροίσματος δειγματοληψίας είναι P."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "translated",
            "value": "Select from the most probable tokens whose sum sampling rate is P."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Select from the most probable tokens whose sum sampling rate is P."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Select from the most probable tokens whose sum sampling rate is P."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione entre los tokens más probables cuya tasa de muestreo suma sea P."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione entre los tokens más probables cuya tasa de muestreo suma sea P."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse todennäköisimmistä tokeneista, joiden summanäytetaajuus on P."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez parmi les jetons les plus probables dont le taux d'échantillonnage de somme est P."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez parmi les jetons les plus probables dont le taux d'échantillonnage de somme est P."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר מבין האסימונים הסבירים ביותר שקצב דגימת הסכום שלהם הוא P."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वाधिक संभावित टोकनों में से चुनें जिनका योग नमूनाकरण दर P है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite između najvjerojatnijih tokena čija je stopa uzorkovanja zbroja P."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válasszon a legvalószínűbb tokenek közül, amelyek összesített mintavételi gyakorisága P."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih dari token yang paling mungkin yang jumlah sampling ratenya adalah P."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona tra i token più probabili la cui frequenza di campionamento somma è P."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計サンプリング レートが P である最も可能性の高いトークンから選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "총 샘플링 비율이 P인 가장 가능성이 높은 토큰 중에서 선택합니다."
