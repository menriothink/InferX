    "Limit the number of tokens generated by the model. Max: %lld.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد من عدد الرموز المميزة التي تم إنشاؤها بواسطة النموذج. الحد الأقصى: %lld."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Limiteu el nombre de fitxes generades pel model. Màxim: %lld."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezte počet tokenů generovaných modelem. Max: %lld."
          }
        },
        "da": {
